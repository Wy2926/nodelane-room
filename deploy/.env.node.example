# 官方镜像仓库和明确版本。
NODELANE_REGISTRY=docker.nodelane.net
NODELANE_VERSION=0.2.0
# 独立实例固定项目名和身份目录；升级时保留。
NODE_PROJECT_NAME=nlroom-node
# 挂载目录必须 root:root、0700。首次可执行 sudo install -d -m 0700 -o 0 -g 0 ./state。
NODE_STATE_DIR=./state
# 控制面的 HTTPS 地址。
NODE_CONTROL_URL=https://room.example.com
# 与网页登记端口及宿主/云安全组放行一致。
NODE_PORT=4242
# 接入密钥在容器终端输入，不放入 .env 或 YAML。
