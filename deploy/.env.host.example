# 已有 PostgreSQL + 反向代理：复制为 .env，权限 0600。
# 必填：已有实例上专供 NodeLane 使用的数据库连接串（先创建数据库及用户）。
# 使用宿主机映射端口，不是 PostgreSQL 容器内部端口；不要填 localhost。
# 密码中的 @、:、/、#、% 等须做 URL 编码；单引号避免 Compose 展开 $。
# sslmode 按现有数据库策略设置；disable 仅适用于可信本机容器网络。
DATABASE_URL='postgres://nodelane:REPLACE_WITH_PASSWORD@host.docker.internal:5432/nodelane?sslmode=disable'

# 必填：反代容器能访问的宿主机 Docker 网桥 IP，并在反代上使用相同 IP。
# 用 docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'
# 查询本机默认网桥地址，确认反代可达后填写；不要填反代容器 IP 或公网 IP。
# 仅当反代直接运行在宿主机上时填写 127.0.0.1；远端反代使用受限私网 IP。
CONTROL_BIND_IP=REPLACE_WITH_HOST_BRIDGE_IP

# 以下均可不填；仅版本升级、端口冲突或需要调整时添加到 .env。
# NODELANE_VERSION=0.2.0
# CONTROL_PORT_A=18080
# CONTROL_PORT_B=18081
# NODELANE_NETWORK=10.203.0.0/16
# CA_DIR=./secrets
# NODELANE_REGISTRY=docker.nodelane.net
# CONTROL_PROJECT_NAME=nodelane-room
# 仅配合 compose.network.yaml 使用；这是 Docker 网络名，不是游戏地址池。
# CONTROL_DOCKER_NETWORK=1panel-network
# 地址池不能与宿主/Docker/LAN 路由重叠，投入使用后不能直接更改。
# 已有部署保持 CA_DIR、NODELANE_NETWORK 和项目名不变。

# Web 管理与节点接入使用的完整 HTTPS origin。
PUBLIC_URL=https://room.example.com
