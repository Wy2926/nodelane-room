# 创建 PostgreSQL、配置 Caddy 及可选实例参数；管理入口执行 admin path 查询。
ROOM_DOMAIN=room.example.com
# 新数据库密码使用随机 URL 安全字符，并在初始化页面的连接串中使用同一密码。
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
# NODELANE_CONTROL_VERSION=0.3.0
# HTTP_PORT=80
# HTTPS_PORT=443
# 留空自动生成并持久化；自定义为 / 加 16–128 位字母、数字、下划线或短横线。
# NODELANE_ADMIN_PATH=/replace-with-your-private-entry
# 默认自动拉取 DB-IP City Lite；可填写自己的 HTTPS .mmdb.gz 镜像地址。
# NODELANE_GEOIP_URL=https://download.db-ip.com/free/dbip-city-lite-{month}.mmdb.gz

# 客户端更新：密钥由部署秘密管理注入，公开根须额外只读挂载；见 docs/updates.md。
# NODELANE_UPDATE_ROOT=/run/nodelane-update/root.json
# NODELANE_UPDATE_STORAGE_KEY=
