# 全套自建（含 PostgreSQL/Caddy）：复制为 .env，权限 0600。
# 已有数据库和反代时使用 .env.host.example + compose.host.yaml。

# 必填：玩家连接的 HTTPS 域名，不带 https:// 或路径；DNS 指向控制机。
ROOM_DOMAIN=room.example.com
# 必填：数据库密码，用 openssl rand -hex 32 生成；仅用字母、数字、_、-。
# 已有数据库沿用原密码，改此值不会自动修改数据库内密码。
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_SECRET
# 镜像仓库，不带 https://。
NODELANE_REGISTRY=docker.nodelane.net
# 控制、迁移和节点使用同一发布版本；amd64/arm64 由 Docker 自动选择。
NODELANE_VERSION=0.2.0
# Compose 项目名；已有部署不要改，否则会使用另一套持久化卷。
CONTROL_PROJECT_NAME=nodelane-room
# 虚拟地址池，支持规范 IPv4 /16 到 /28；不能与宿主/Docker/LAN 路由重叠。
# CA 初始化、迁移和控制副本使用同一值；投入使用后不可直接更改。
NODELANE_NETWORK=10.203.0.0/16
# CA 宿主目录，相对路径以 compose.yaml 所在目录为准；目录权限 0700。
# 初始化前属主对应 CA_INIT_UID/GID，初始化后改为 10001:10001。
CA_DIR=./secrets
# 仅 ca-init 使用：运行 mkdir 的 Linux 用户 UID，以 id -u 查询。
CA_INIT_UID=1000
# 仅 ca-init 使用：运行 mkdir 的 Linux 用户 GID，以 id -g 查询。
CA_INIT_GID=1000
# Caddy 宿主 HTTP 端口；直接公网部署/ACME HTTP 验证使用 80。
HTTP_PORT=80
# Caddy 宿主 HTTPS 端口；直接公网部署使用 443。
HTTPS_PORT=443

# Web 管理与节点接入使用的完整 HTTPS origin。
PUBLIC_URL=https://room.example.com
