; NodeLane Room installer messages.
LangString Branding ${LANG_ENGLISH} "NodeLane · Play in the same room"
VIAddVersionKey /LANG=${LANG_ENGLISH} "FileDescription" "NodeLane Room Setup and Maintenance"
LangString WelcomeTitle ${LANG_ENGLISH} "Welcome to$\r$\nNodeLane Room"
LangString WelcomeText ${LANG_ENGLISH} "Play in the same room with friends.$\r$\n$\r$\nThis wizard installs the game client and network service, or maintains an existing installation.$\r$\n$\r$\nVersion ${VERSION} · ${ARCH}$\r$\nDevelopment build · Not code signed$\r$\n$\r$\nRun from your everyday Windows gaming account. Windows will request administrator approval when installation starts."
LangString InstallingTitle ${LANG_ENGLISH} "Configuring NodeLane Room"
LangString InstallingSubtitle ${LANG_ENGLISH} "Please wait while files are verified and the network service is configured."
LangString FinishTitle ${LANG_ENGLISH} "NodeLane Room is ready"
LangString FinishText ${LANG_ENGLISH} "Installation is complete. Open the client to play with friends.$\r$\n$\r$\nUninstall from Installed apps in Windows Settings. Run the complete installer again to update or restore the previous version."
LangString OpenRoom ${LANG_ENGLISH} "Open NodeLane Room"
LangString UninstallWelcomeTitle ${LANG_ENGLISH} "Uninstall$\r$\nNodeLane Room"
LangString UninstallWelcomeText ${LANG_ENGLISH} "This wizard removes the NodeLane Room client and network service.$\r$\n$\r$\nUninstalling ends the current connection and closes this device's tunnel.$\r$\n$\r$\nDevice identity and player binding are kept by default. You can choose to clear local data on the next page."
LangString UninstallingTitle ${LANG_ENGLISH} "Uninstalling NodeLane Room"
LangString UninstallingSubtitle ${LANG_ENGLISH} "Please wait while connections are stopped and programs are removed."
LangString UninstallFinishTitle ${LANG_ENGLISH} "NodeLane Room removed"
LangString UninstallFinishText ${LANG_ENGLISH} "The client and network service have been removed.$\r$\n$\r$\n$FinishText$\r$\n$\r$\nThank you for using NodeLane Room."
LangString ArchitectureError ${LANG_ENGLISH} "Choose the 64-bit installer that matches your system architecture."
LangString OptionsTitle ${LANG_ENGLISH} "Installation and maintenance"
LangString OptionsSubtitle ${LANG_ENGLISH} "Check the version and location, then choose an action."
LangString InstallLocation ${LANG_ENGLISH} "Protected installation folder:$\r$\n$INSTDIR"
LangString InstallAction ${LANG_ENGLISH} "Install NodeLane Room"
LangString UpdateAction ${LANG_ENGLISH} "Install / update to ${VERSION} (current: $CurrentVersion)"
LangString RestoreAction ${LANG_ENGLISH} "Restore the previous version (keep device identity)"
LangString Requirements ${LANG_ENGLISH} "Includes the client, network service and signed TAP driver. A dedicated adapter is created automatically. Missing WebView2 is installed online.$\r$\nUpdates briefly interrupt connections. A failed update restores the previous programs."
LangString InstallingDetail ${LANG_ENGLISH} "Verifying files, requesting administrator approval and configuring the service…"
LangString InstallError ${LANG_ENGLISH} "Installation did not complete. Administrator approval may have been cancelled, or file verification / service startup failed. Review the details and retry. Device identity is not cleared automatically."
LangString DataRetained ${LANG_ENGLISH} "Device identity and player binding were kept for future reinstallation."
LangString UninstallOptionsTitle ${LANG_ENGLISH} "Confirm removal"
LangString UninstallOptionsSubtitle ${LANG_ENGLISH} "Choose whether to keep local data, then click Uninstall."
LangString RemovalList ${LANG_ENGLISH} "Removes the client, network service, installer-created adapter, Start menu entry and previous version backup.$\r$\n$INSTDIR"
LangString PurgeAction ${LANG_ENGLISH} "Also clear device identity and player binding"
LangString PurgeHelp ${LANG_ENGLISH} "Leave unchecked to keep your identity for reinstallation.$\r$\nClearing data cannot be undone. You will need to initialize again after reinstalling.$\r$\nServer rooms and the shared WebView2 runtime are not removed."
LangString PurgeConfirm ${LANG_ENGLISH} "Clear this device's identity and player binding? This cannot be undone."
LangString DataCleared ${LANG_ENGLISH} "Device identity and player binding were cleared. Initialize again after reinstalling."
LangString UninstallError ${LANG_ENGLISH} "Uninstallation did not complete. Check administrator approval or the error details, then retry."
