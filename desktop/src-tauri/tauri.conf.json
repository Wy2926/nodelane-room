{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NodeLane Room",
  "version": "0.2.1",
  "identifier": "net.nodelane.room",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "NodeLane Room", "width": 1120, "height": 760, "minWidth": 760, "minHeight": 560, "decorations": false, "shadow": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"], "category": "Game", "shortDescription": "NodeLane 游戏联机客户端" }
}
